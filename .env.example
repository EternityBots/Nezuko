# --- Required ---
# Your MongoDB connection string (stores the WhatsApp session, XP, settings)
MONGODB=mongodb+srv://user:password@cluster.example.mongodb.net/nezuko
# Bot owners: phone numbers with country code, digits only, comma separated
MODS=919876543210
# Command prefix (one character)
PREFIX=.
# Name of the stored session. Also the password for the /qr page.
SESSION_ID=NEZUKO

# --- Linking ---
# Leave empty to link with a QR code (printed in the terminal and served at /qr?session=SESSION_ID).
# Set to the bot's own number (digits only) to link with an 8-digit pairing code instead.
PAIRING_NUMBER=

# --- Optional API keys ---
# Google Custom Search (console.developers.google.com) for the google command
GOOGLE_API=
GOOGLE_CX=
# weatherapi.com key for the weather command
WEATHER_API=
# Spotify app credentials (developer.spotify.com) for full track details in the spotify command
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# --- YouTube (youtubei.js) ---
# The bot generates YouTube PO tokens automatically (BotGuard via bgutils-js). Set to false to turn that off.
YT_AUTO_PO_TOKEN=true
# Optional cookie string from a throwaway YouTube account. Setting it turns off automatic PO tokens.
YT_COOKIE=
# Optional fixed Proof-of-Origin token (also turns off automatic generation)
YT_PO_TOKEN=
# Clients to try for downloads, in order. Leave empty for the default (MWEB,WEB_EMBEDDED,IOS,ANDROID_VR
# when a PO token is available, plus TV when YT_COOKIE is set). Run "bun run yt-check <link>" to see which work for you.
YT_CLIENTS=
# Downloader: auto (yt-dlp if installed, then youtubei.js), youtubei, or yt-dlp
YT_DOWNLOADER=auto
# Path to yt-dlp if it isn't on PATH
YTDLP_PATH=
# Extra yt-dlp options. If YouTube asks yt-dlp to sign in, let it read cookies from a browser on this
# machine, ideally a separate profile logged into a throwaway account, e.g.:
#   YTDLP_ARGS=--cookies-from-browser firefox
#   YTDLP_ARGS=--cookies-from-browser "chrome:Profile 2"
YTDLP_ARGS=
MAX_AUDIO_MINUTES=20
MAX_VIDEO_MINUTES=10
MAX_VIDEO_HEIGHT=720

# --- Misc ---
PORT=8080
# Baileys log level: silent, error, warn, info, debug
LOG_LEVEL=silent
