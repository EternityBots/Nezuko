{
  "name": "nezuko",
  "version": "5.0.0",
  "description": "A simple and easy-to-use WhatsApp bot based on Multi-Device Baileys, written in TypeScript. Runs on Bun or Node.js.",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "start": "bun run src/index.ts",
    "dev": "bun --watch src/index.ts",
    "build": "tsc -p .",
    "start:node": "node dist/index.js",
    "typecheck": "tsc --noEmit -p .",
    "test": "bun test",
    "reset-session": "bun run src/scripts/reset-session.ts",
    "reset-session:node": "node dist/scripts/reset-session.js",
    "yt-check": "bun run src/scripts/yt-check.ts",
    "yt-check:node": "node dist/scripts/yt-check.js"
  },
  "engines": {
    "node": ">=20.0.0",
    "bun": ">=1.2.0"
  },
  "dependencies": {
    "@hapi/boom": "^10.0.1",
    "@napi-rs/canvas": "^0.1.100",
    "baileys": "7.0.0-rc14",
    "bgutils-js": "^4.0.3",
    "canvacord": "6.0.4",
    "cfonts": "^3.3.1",
    "chalk": "^6.0.1",
    "dotenv": "^18.0.8",
    "express": "^5.3.0",
    "file-type": "^22.2.0",
    "genshin-db": "^5.2.14",
    "instagram-url-direct": "^2.0.7",
    "jsdom": "^30.1.3",
    "mathjs": "^15.2.0",
    "moment-timezone": "^0.6.5",
    "mongoose": "^9.11.2",
    "node-webpmux": "^3.2.1",
    "pino": "^10.4.0",
    "qrcode": "^1.5.4",
    "qrcode-terminal": "^0.12.0",
    "sharp": "^0.35.5",
    "youtubei.js": "18.2.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.6.5",
    "@types/qrcode": "^1.5.6",
    "@types/qrcode-terminal": "^0.12.2",
    "typescript": "^7.0.2"
  },
  "trustedDependencies": [
    "baileys",
    "protobufjs",
    "sharp"
  ],
  "author": "Eternity-Team",
  "license": "AGPL-3.0",
  "repository": "https://github.com/EternityBots/Nezuko.git",
  "private": true
}
